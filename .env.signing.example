# macOS code-signing & notarization secrets for `make build-mac`.
# Copy to `.env.signing` (gitignored) and fill in your real values.
#
# This file is auto-sourced by the `build-mac` Makefile target. It is kept
# separate from `.env.local` because Tauri's built-in dotenv loader auto-loads
# `.env.local` with different quoting rules than bash, which silently mangles
# passwords containing special characters ($, *, !, `, \). `.env.signing` is
# NOT auto-loaded by Tauri — bash sources it directly via the Makefile.
#
# Always wrap values in SINGLE QUOTES when they contain special characters:
#   - single quotes preserve everything verbatim (no expansion, no escapes)
#   - double quotes still expand $VAR and process \n etc, so they're risky
#   - if your value contains a literal single quote, use 'foo'\''bar'

# ─── Code-signing certificate ──────────────────────────────────────────────
#
# Base64-encoded contents of the .p12 file exported from Keychain Access.
# Export with "Include all certificates in the certificate path" and
# "Allow all applications to use this key" so the chain is complete.
# Encode with:
#   base64 -i developer-id.p12 -o developer-id.p12.b64
APPLE_CERTIFICATE='paste-base64-encoded-p12-contents-here'

# The password you set when exporting the .p12 from Keychain Access.
APPLE_CERTIFICATE_PASSWORD='your-p12-export-password'

# The Common Name (or full "Developer ID Application: …" subject) of the
# code-signing identity inside the .p12. Find it with:
#   security find-identity -v -p codesigning
APPLE_SIGNING_IDENTITY='Developer ID Application: Your Name (TEAMID1234)'

# ─── Notarization (Apple Notary service) ───────────────────────────────────
#
# Your Apple ID (the one with an active Developer Program membership).
APPLE_ID='you@example.com'

# An app-specific password generated at https://appleid.apple.com (NOT your
# Apple ID password). Format: xxxx-xxxx-xxxx-xxxx
APPLE_PASSWORD='xxxx-xxxx-xxxx-xxxx'

# Your 10-character Apple Developer Team ID. Find it at
# https://developer.apple.com/account → Membership.
APPLE_TEAM_ID='TEAMID1234'
