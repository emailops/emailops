{
  "name": "emailops",
  "version": "0.5.2",
  "private": true,
  "description": "Privacy-first, AI-native email client. All AI processing happens locally.",
  "author": "Gero DP",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/emailops/emailops.git"
  },
  "homepage": "https://github.com/emailops/emailops",
  "bugs": {
    "url": "https://github.com/emailops/emailops/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "check": "npm run lint && npm run typecheck && npm run test:all && npm run clippy",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "fmt": "biome format --write src/",
    "clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "generate-types": "cargo test --manifest-path src-tauri/Cargo.toml --features ts -- export_bindings --nocapture",
    "test:frontend": "vitest run",
    "test:all": "npm run test:rust && npm run test:frontend",
    "i18n:check": "i18next 'src/**/*.{ts,tsx}' --config i18next-parser.config.cjs --silent --dry-run",
    "i18n:extract": "i18next 'src/**/*.{ts,tsx}' --config i18next-parser.config.cjs",
    "i18n:no-jsx-literals": "node scripts/check-jsx-literals.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.3",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tiptap/extension-image": "^3.26.1",
    "@tiptap/extension-link": "^3.26.1",
    "@tiptap/extension-underline": "^3.26.1",
    "@tiptap/pm": "^3.26.1",
    "@tiptap/react": "^3.26.1",
    "@tiptap/starter-kit": "^3.26.1",
    "date-fns": "^3.6.0",
    "dompurify": "^3.4.10",
    "i18next": "^26.3.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@biomejs/cli-darwin-x64": "^2.5.0",
    "@tailwindcss/postcss": "^4.3.1",
    "@tauri-apps/cli": "^2.11.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.0",
    "i18next-parser": "^9.0.2",
    "jsdom": "^29.1.1",
    "lefthook": "^2.1.9",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
