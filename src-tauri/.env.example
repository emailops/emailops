# Gmail OAuth Credentials
# Get these from Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Create an OAuth 2.0 Client ID (type: Desktop app) with Gmail API enabled
EMAILOPS_GMAIL_CLIENT_ID=your-client-id.apps.googleusercontent.com
EMAILOPS_GMAIL_CLIENT_SECRET=your-client-secret

# Outlook / Microsoft Graph OAuth Credentials
# Register an app at https://portal.azure.com → Microsoft Entra ID → App registrations
# Recommended: register as "Mobile and desktop applications" with redirect URI
# http://localhost. This is a PUBLIC CLIENT and uses PKCE — no secret needed.
# (Azure rejects a client_secret for public clients with AADSTS90023.)
# Only set EMAILOPS_OUTLOOK_CLIENT_SECRET if you registered a confidential
# client instead.
EMAILOPS_OUTLOOK_CLIENT_ID=your-azure-app-client-id
# EMAILOPS_OUTLOOK_CLIENT_SECRET=your-confidential-client-secret

# Dev mode: store OAuth tokens in SQLite instead of OS keychain (dev only)
# EMAILOPS_DEV_TOKENS=1

# OpenRouter API key (optional, for cloud AI models)
# Get one at: https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-...
