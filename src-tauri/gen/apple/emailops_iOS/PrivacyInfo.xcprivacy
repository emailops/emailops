<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Apple privacy manifest. Source of truth: this file is copied into
  gen/apple/emailops_iOS/ by scripts/ios_patch_project.sh, because everything
  under gen/apple/ is regenerated by `tauri ios init`.

  Two independent declarations live here:

  * NSPrivacyCollectedDataTypes — what the *developer* collects. Empty, and
    that is a factual claim about this build: no analytics, no crash-reporting
    SDK, no telemetry (the OTLP tracing connector is behind the non-default
    `tracing` Cargo feature). Mail never leaves the device except to the user's
    own provider and, only when the user supplies an API key, OpenRouter —
    neither of which is collection by us. This must stay in sync with the App
    Store Connect nutrition label.

  * NSPrivacyAccessedAPITypes — "required reason" APIs the binary links,
    regardless of who calls them. Under-declaring is an automatic rejection
    (ITMS-91053), so anything plausibly reachable is declared with its real
    reason. If App Store Connect reports a category not listed here, add it
    rather than removing the call.
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<!-- fs4::available_space (util/system.rs) — checked before a model
		     download, and surfaced in Settings → Storage. -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryDiskSpace</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>85F4.1</string>
				<string>E174.1</string>
			</array>
		</dict>
		<!-- std::fs metadata (stat) on files inside the app container:
		     storage_stats.rs walks the data dir, model_manager.rs sizes a
		     partial download. -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
		<!-- UserDefaults, reached through WKWebView and the Tauri plugins
		     (deep-link registration), not by app code directly. -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
		<!-- KERN_BOOTTIME via the `sysinfo` crate, which is linked on every
		     target even though `total_ram_bytes` uses os_proc_available_memory
		     on iOS. Declared because linkage, not call sites, is what Apple's
		     scan reports. -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategorySystemBootTime</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>35F9.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
